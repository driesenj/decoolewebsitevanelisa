# Immich (npm run sync). Maak de API-sleutel in Immich: Account -> API-sleutels, rechten album.read, asset.read, asset.download
IMMICH_URL=https://immich.jouwdomein.be
IMMICH_API_KEY=plak-hier-je-sleutel
# Chatberichten verwijderen (npm run chat -- delete ...): pad naar de service-account-sleutel van het Firebase-project
# (standaard firebase/service-account.json; maken via Firebase console -> Projectinstellingen -> Serviceaccounts)
# FIREBASE_SERVICE_ACCOUNT=firebase/service-account.json
